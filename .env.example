# =============================================================================
# REQUIRED FOR NETLIFY DEPLOYMENT & PRODUCTION ASSISTANT (JESS)
# =============================================================================
# Gemini server credential. NEVER expose this to the browser.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Firebase browser configuration. Keep values out of source control.
# Firebase Web API keys are public browser configuration, not authorization secrets.
FIREBASE_WEB_API_KEY="YOUR_FIREBASE_WEB_API_KEY"
FIREBASE_PROJECT_ID="gen-lang-client-0197530608"
FIRESTORE_DATABASE_ID="ai-studio-hubmind-4cac2024-c6eb-4208-80cf-928714dfd430"
FIREBASE_APP_ID="1:691762959980:web:0979e7745677270cc92a49"
FIREBASE_AUTH_DOMAIN="gen-lang-client-0197530608.firebaseapp.com"
FIREBASE_STORAGE_BUCKET="gen-lang-client-0197530608.firebasestorage.app"
FIREBASE_MESSAGING_SENDER_ID="691762959980"

# Firebase Google Sign-In Web OAuth Client ID (must belong to Firebase project 691762959980)
# Used by Android GoogleSignInOptions.requestIdToken(...) and Firebase Authentication.
FIREBASE_GOOGLE_CLIENT_ID="691762959980-2jsohrd8s1elb4f84t3592vl728nhek7.apps.googleusercontent.com"
VITE_GOOGLE_CLIENT_ID="691762959980-2jsohrd8s1elb4f84t3592vl728nhek7.apps.googleusercontent.com"

APP_URL="https://your-site.netlify.app"

# Server-only Google OAuth credentials for Google Calendar & Drive. NEVER use the VITE_ prefix for secrets.
# GOOGLE_CLIENT_ID can be the same Web OAuth client ID or a dedicated Calendar/Drive Web OAuth client ID.
GOOGLE_CLIENT_ID="691762959980-2jsohrd8s1elb4f84t3592vl728nhek7.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="YOUR_GOOGLE_CLIENT_SECRET"
# Long random server-only secret used to sign OAuth state and encrypt refresh tokens at rest.
GOOGLE_OAUTH_SECRET="YOUR_LONG_RANDOM_OAUTH_SECRET"
# Optional; if omitted Hub-Mind derives this from APP_URL.
GOOGLE_OAUTH_REDIRECT_URI="https://your-site.netlify.app/api/google-oauth-callback"

# Optional server-only GitHub personal access token. Enables authenticated API rate limits.
# Never expose this with a VITE_ prefix or send it to the renderer.
GITHUB_TOKEN="YOUR_GITHUB_TOKEN"
